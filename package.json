    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.5.0",
    "react-syntax-highlighter": "^15.5.0",
    "tesseract.js": "^6.0.1",
    "use-debounce": "^10.0.6"
