{
  "name": "uncommonstash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/prebuild-blog.mjs && node scripts/collect-tools.mjs",
    "dev": "node scripts/prebuild-blog.mjs && node scripts/collect-tools.mjs && vite",
    "dev:e2e": "node scripts/prebuild-blog.mjs && node scripts/collect-tools.mjs && vite --port 3000",
    "build": "node scripts/prebuild-blog.mjs && node scripts/collect-tools.mjs && tsc -b && vite build && node scripts/postbuild-pages.mjs",
    "build:tools": "node scripts/collect-tools.mjs",
    "build:blog": "node scripts/prebuild-blog.mjs",
    "preview": "vite preview --port 3000",
    "lint": "eslint",
    "lint:biome": "biome check .",
    "test": "jest"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
